# Airbnb Automate Configuration
# Copy this file to .env and fill in your values

# Database
DATABASE_PATH=data/airbnb_automate.db

# Search URLs (structured flexible search matches Airbnb explore UI)
# AIRBNB_BASE_URL=https://www.airbnb.co.in
# FLEX_TRIP_MONTHS_COUNT=3

# Browser settings
HEADLESS=true

# Airbnb login. Run `python manage.py login` once — Airbnb blocks automated
# sign-in, so a human does it and the persistent profile keeps the session
# (data/airbnb_browser_profile + a data/browser_state.json cookie backup).
# Run: playwright install chrome, then set PLAYWRIGHT_CHANNEL=chrome
# (recommended — OAuth is far more reliable in real Chrome).
#
# PLAYWRIGHT_CHANNEL=chrome
# BROWSER_USER_DATA_DIR=data/airbnb_browser_profile
# CHROME_CDP_URL=http://127.0.0.1:9222

# Send budget — ONE cap shared by outreach AND negotiation replies.
# Default ≈ 40 messages / day (eight 3h windows × 5 sends).
# OUTREACH_MAX_SENDS_PER_WINDOW=5
# OUTREACH_RATE_WINDOW_SECONDS=10800
# Pause between each attempt (spread bursts; default 120s)
# OUTREACH_INTER_MESSAGE_DELAY_SECONDS=120

# ─── Agent / LLM settings ───────────────────────────────────────────────
# Provider: openai | gemini | perplexity
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.7
#
# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
#
# Google Gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
#
# Perplexity (OpenAI-compatible) — good for the Scout, it cites sources
# PERPLEXITY_API_KEY=pplx-...
# PERPLEXITY_MODEL=sonar-pro

# ─── Guardrails ─────────────────────────────────────────────────────────────────
# These seed the policy table on first run. After that, change them from the
# dashboard (POST /api/policy) — the worker re-reads policy before every send,
# so a change takes effect without a restart.
#
# The agents run fully autonomously up to Airbnb's payment wall, so these are
# the only things standing between an LLM and a commitment you have to honour.
# The Warden enforces them in code on the final text; the prompt is only a hint.

# Most an agent may ever agree to pay per night. 0 = free stays only; any paid
# counter-offer is escalated to you instead of accepted.
# MAX_PRICE_PER_NIGHT=0
# PRICE_CEILING_CURRENCY=INR

# The only things an agent may promise a host. Comma separated; the quantity in
# each entry is the cap, so "2 IG reels" blocks any draft offering three.
# Avoid spelling out platform names here — whatever you write lands in the draft,
# and Airbnb refuses messages naming them (see BLOCKED_MESSAGE_TERMS below).
# ALLOWED_DELIVERABLES=2 IG reels,10 edited photos,1 honest public review

# Airbnb will not deliver a first message containing links or contact details,
# and it counts social-platform names as contact details. Each entry is
# "term=replacement"; an empty replacement means drop the word entirely. The
# Warden blocks these before a send is ever attempted.
# BLOCKED_MESSAGE_TERMS=instagram=IG,facebook=FB,tiktok=,youtube=,snapchat=,linkedin=,twitter=

# Replies one thread may receive before it is parked for you to read.
# MAX_AGENT_REPLIES_PER_THREAD=4

# The credential fact sheet. An agent may not claim anything beyond this, and
# the Warden checks every draft against it.
# CREATOR_NAME=Sachin Kumar Shukla
# CREATOR_ROLE=remote software engineer and founder of The Boring Education
# CREATOR_FOLLOWERS=150k+ combined
# CREATOR_HANDLES=@theboringfounder, @theboringeducation

